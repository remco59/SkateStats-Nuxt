# Copy to .env and fill in real values before running.

# Both must point at the SAME file: NUXT_DB_PATH is what the running app
# actually reads (Nuxt's runtimeConfig env override -- nuxt.config.ts's
# `dbPath` default is baked in at BUILD time, so setting only SKATESTATS_DB
# here has no effect on the running server); SKATESTATS_DB is what
# scripts/bootstrap-admin.ts and scripts/migration-spike.ts read directly,
# since they run standalone outside the Nuxt runtime. Keep them identical.
NUXT_DB_PATH=/data/skatestats.sqlite
SKATESTATS_DB=/data/skatestats.sqlite
SKATESTATS_TITLE=SkateStats
SKATESTATS_OWNER_NAME=Your Name
SKATESTATS_ADMIN_USERNAME=admin

# Seals the session cookie (nuxt-auth-utils). Must be at least 32 characters.
# Generate with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-plus-character-secret

# Shared between the app and the `updater` sidecar (docker/updater) so the
# admin panel's "update" button can trigger a `git pull` + rebuild without
# giving the public-facing skatestats container access to the Docker
# socket. Required for that feature to work; generate with:
# openssl rand -hex 32
UPDATER_SECRET=change-me-to-a-random-secret
UPDATER_URL=http://updater:4001
