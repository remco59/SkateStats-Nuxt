# Copy to .env and fill in real values before running.

SKATESTATS_DB=/data/skatestats.sqlite
SKATESTATS_TITLE=SkateStats
SKATESTATS_OWNER_NAME=Your Name
SKATESTATS_ADMIN_USERNAME=admin

# Seals the session cookie (nuxt-auth-utils). Must be at least 32 characters.
# Generate with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-plus-character-secret
