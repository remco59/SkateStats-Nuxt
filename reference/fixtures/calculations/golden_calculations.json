  "race_level_duplicate_matching": {
    "description": "race_is_duplicate() (old app) considers a candidate a duplicate of an existing race in the SAME competition only if total_time_ms, lane, opponent, laps_csv, and dnf ALL match exactly. It does not consider distance_m at all beyond what's implied by matching within a competition+distance context. Two races on the same day at the same distance with different opponents/lanes are correctly treated as distinct (e.g. two heats), but two independently-typo'd imports with an empty lane/opponent and identical time/laps are silently merged.",
    "not_duplicate_example": {
      "existing": {
        "total_time_ms": 133900,
        "lane": "gl",
        "opponent": "Pietersen, Joris",
        "laps_csv": "41.50,30.20,30.80,31.40",
        "dnf": 0
      },
      "candidate": {
        "total_time_ms": 133900,
        "lane": "bl",
        "opponent": "Jansen, Remco",
        "laps_csv": "41.50,30.20,30.80,31.40",
        "dnf": 0
      },
      "expected_is_duplicate": false,
      "why": "different lane/opponent \u2014 same time by coincidence (a real dead heat), correctly kept as two separate races."
    },
    "duplicate_example": {
      "existing": {
        "total_time_ms": 133900,
        "lane": null,
        "opponent": null,
        "laps_csv": null,
        "dnf": 0
